# Digital Gullak — example environment.
# Copy to .env (or run `npm run setup`, which generates random demo secrets for you).
# These values are placeholders. Never commit real credentials.

NODE_ENV=development
PORT=8787
HOST=127.0.0.1

# Comma-separated browser origins allowed to make state-changing requests.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787,http://127.0.0.1:8787

# SQLite database file. Tip: if this folder is synced by OneDrive/Dropbox,
# point this at a non-synced location, e.g. C:/gullak-data/gullak.db
DATABASE_PATH=./data/gullak.db

# --- Simulated-money boundary --------------------------------------------
# The only provider in this build is the mock partner bank. The server refuses
# to start if DEMO_MODE is not true, if LIVE_MONEY_ENABLED is true, or if
# BANK_PROVIDER is anything other than "mock".
DEMO_MODE=true
LIVE_MONEY_ENABLED=false
BANK_PROVIDER=mock

# --- Secrets (demo placeholders; replace with long random values) ---------
# Keyed hash for phone lookups and OTP codes. Changing it makes existing
# demo users unable to sign back in with the same number.
AUTH_HMAC_SECRET=replace-with-a-long-random-string
# Passcode for the operator console at /ops (demo only; a real deployment
# needs SSO + MFA for staff).
OPERATOR_PASSCODE=replace-with-a-demo-operator-passcode
# Shared secret the mock partner uses to sign webhooks.
MOCK_PROVIDER_WEBHOOK_SECRET=replace-with-a-long-random-string

# How long the mock partner takes to confirm a transfer (milliseconds).
MOCK_PROVIDER_SETTLE_MS=1800

# Set to true when serving over HTTPS.
COOKIE_SECURE=false

LOG_LEVEL=info
